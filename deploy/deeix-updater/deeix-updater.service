[Unit]
Description=DEEIX Chat host updater
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/deeix-updater/deeix-updater.env
ExecStart=/usr/local/lib/deeix-updater/deeix-updater
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
ReadWritePaths=/var/lib/deeix-updater /run/deeix-updater __DEPLOYMENT_DIR__
RuntimeDirectory=deeix-updater
StateDirectory=deeix-updater
UMask=007

[Install]
WantedBy=multi-user.target
