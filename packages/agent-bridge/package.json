{
  "name": "@deeix/agent-bridge",
  "version": "0.4.22",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "deeix-agent-bridge": "./dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "dist/generated",
    "generated/codex-app-server-v0.147.0/json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit --pretty false",
    "check:schema": "node scripts/check-codex-app-server-lock.mjs ../../docs/agent-runtime/codex-app-server-v0.147.0.lock.json generated/codex-app-server-v0.147.0/ts generated/codex-app-server-v0.147.0/json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "pnpm build && node --test dist/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "7.0.2"
  }
}
